{
  "name": "pi-glean",
  "version": "0.1.0",
  "description": "Zero-config web search and URL fetching for pi — works with no API keys, and uses your ChatGPT Plus/Pro or xAI subscription for higher-quality answers when available. Plus GitHub repos, PDFs, YouTube, and video frames.",
  "keywords": [
    "chatgpt",
    "codex",
    "fetch",
    "github",
    "glean",
    "grok",
    "jina",
    "jina-reader",
    "markdown",
    "openai-codex",
    "pdf",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-mono",
    "pi-package",
    "readability",
    "tool-extension",
    "video",
    "web-fetch",
    "web-search",
    "web_search",
    "x-search",
    "xai",
    "youtube",
    "yt-dlp"
  ],
  "homepage": "https://github.com/pacoyang/pi-glean#readme",
  "bugs": {
    "url": "https://github.com/pacoyang/pi-glean/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pacoyang/pi-glean"
  },
  "files": [
    "index.ts",
    "src",
    "package.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md"
  ],
  "type": "module",
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "lint": "oxlint .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "pre-commit": "prek run",
    "audit:runtime": "npm audit --omit=dev --omit=peer"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.0",
    "p-limit": "^6.2.0",
    "promise.try": "^2.0.1",
    "turndown": "^7.2.0",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.82.0",
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@earendil-works/pi-tui": "^0.82.0",
    "@j178/prek": "^0.4.4",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
